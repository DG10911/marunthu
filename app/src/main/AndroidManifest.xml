<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      PRIVACY PROOF: Marunthu declares NO android.permission.INTERNET.
      The app is structurally incapable of uploading medicine images, OCR text,
      health data, or conversations. This is the strongest possible offline claim.
      Camera + microphone are the only sensitive permissions.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <!-- ML Kit Latin OCR model is bundled (no first-run download needed). -->
    <application
        android:name=".MarunthuApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="Marunthu"
        android:supportsRtl="true"
        android:theme="@style/Theme.Marunthu"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Marunthu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
